// For format details, see https://aka.ms/devcontainer.json. For config options, see the README at:
// https://github.com/devcontainers/images/tree/main/src/python
{
	"name": "fg-data-profiling",
	"build": {
		"dockerfile": "Dockerfile",
		// The Dockerfile copies nothing, so keep the context small (avoids sending .venv and .git to Docker).
		"context": ".",
		"args": {
			// Python version: 3.10 to 3.14 are supported by the package.
			"VARIANT": "3.12-bookworm"
		}
	},

	"customizations": {
		"vscode": {
			"settings": {
				"python.defaultInterpreterPath": "/usr/local/bin/python"
			},
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-toolsai.jupyter"
			]
		}
	},

	// Dependencies live in pyproject.toml; install the package in editable mode with dev, test and notebook extras.
	"postCreateCommand": "python -m pip install --upgrade pip && python -m pip install --user -e \".[dev,test,notebook]\"",

	// pip --user installs scripts (data_profiling, jupyter, pytest) here.
	"remoteEnv": {
		"PATH": "${containerEnv:PATH}:/home/vscode/.local/bin"
	},

	"remoteUser": "vscode"
}
